{
  "name": "techosoul-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:library && npm run typecheck && vite build",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "format": "prettier --write apps/showcase/src packages/techosoul-ui/src examples/consumer-app/src scripts tests .storybook *.ts docs/*.md README.md",
    "build:demo": "npm run build:library && npm run typecheck && vite build --base=/Techosoul-UI/",
    "build:library": "npm run build -w @techosoul/ui",
    "typecheck": "tsc --noEmit",
    "validate:consumer": "node scripts/validate-consumer.mjs",
    "test:consumer": "playwright test --config playwright.consumer.config.ts",
    "measure:package": "node scripts/package-metrics.mjs",
    "docs:sync": "node scripts/sync-documentation.mjs",
    "docs:check": "node scripts/sync-documentation.mjs --check && node scripts/check-documentation-links.mjs",
    "inspect:package": "node scripts/inspect-package.mjs",
    "test:scripts": "node --test scripts/build-library.test.mjs scripts/run-npm.test.mjs scripts/check-registry-version.test.mjs scripts/release-guards.test.mjs",
    "test:release": "node --test scripts/check-registry-version.test.mjs scripts/release-guards.test.mjs",
    "test:pages": "npm run build:demo && playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "antd": "6.6.6",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "storybook": "10.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
