{
  "name": "@techosoul/ui",
  "version": "0.3.0",
  "description": "FinTech-first React design system for precise, accessible, data-intensive interfaces in financial, enterprise and SaaS applications.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./fonts.css": {
      "types": "./dist/fonts.css.d.ts",
      "default": "./dist/fonts.css"
    },
    "./tokens.json": "./dist/tokens.json"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "antd": "^6.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-library.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.58.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morimdn/Techosoul-UI.git",
    "directory": "packages/techosoul-ui"
  },
  "homepage": "https://morimdn.github.io/Techosoul-UI/",
  "bugs": {
    "url": "https://github.com/morimdn/Techosoul-UI/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "design-system",
    "design-tokens",
    "fintech",
    "enterprise",
    "crm",
    "erp",
    "saas",
    "data-grid",
    "antd",
    "accessibility"
  ],
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Dr. Mirmorsal Madani",
    "url": "https://github.com/morimdn"
  }
}
